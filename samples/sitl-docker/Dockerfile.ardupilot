# Headless ArduCopter SITL (no Gazebo, no MAVProxy needed). Builds natively on arm64 and amd64.
FROM ubuntu:22.04
ARG ARDUPILOT_TAG=Copter-4.6.3
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates g++ make python3 python3-pip python3-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir empy==3.3.4 future pexpect pymavlink
RUN git clone --depth 1 --branch ${ARDUPILOT_TAG} https://github.com/ArduPilot/ardupilot.git /ardupilot \
    && cd /ardupilot && git submodule update --init --depth 1 --recursive modules/mavlink modules/waf modules/DroneCAN/libcanard modules/DroneCAN/dronecan_dsdlc modules/DroneCAN/pydronecan modules/DroneCAN/DSDL
WORKDIR /ardupilot
RUN ./waf configure --board sitl && ./waf copter
COPY ardupilot-entrypoint.sh /usr/local/bin/ardupilot-entrypoint.sh
EXPOSE 5760 5762 5763
ENTRYPOINT ["/usr/local/bin/ardupilot-entrypoint.sh"]
