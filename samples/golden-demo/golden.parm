# Loaded after copter.parm via --defaults. Set 1 = GPS, set 2 = ExternalNav (VISION_POSITION_ESTIMATE).
AHRS_EKF_TYPE 3
EK3_ENABLE 1
EK2_ENABLE 0
VISO_TYPE 1
VISO_POS_M_NSE 2.0
EK3_SRC1_POSXY 3
EK3_SRC1_VELXY 3
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 3
EK3_SRC1_YAW 1
EK3_SRC2_POSXY 6
EK3_SRC2_VELXY 0
EK3_SRC2_POSZ 1
EK3_SRC2_VELZ 0
EK3_SRC2_YAW 1
EK3_SRC_OPTIONS 0
WPNAV_SPEED 1000
FENCE_ENABLE 0
